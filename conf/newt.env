# Managed by YunoHost: change values in the app's config panel (webadmin or
#   yunohost app config set __APP__); manual edits are overwritten.
PANGOLIN_ENDPOINT=__PANGOLIN_ENDPOINT__
NEWT_ID=__NEWT_ID__
NEWT_SECRET=__NEWT_SECRET__
LOG_LEVEL=__LOG_LEVEL__
# Self-hosted Pangolin: never fall back to Pangolin Cloud
NO_CLOUD=true
# The SSH auth daemon needs root; disabled because Newt runs unprivileged
DISABLE_SSH=true
