# Managed by YunoHost: change values in the app's config panel (webadmin or
#   yunohost app config set __APP__); manual edits are overwritten.
PANGOLIN_ENDPOINT=__PANGOLIN_ENDPOINT__
NEWT_ID=__NEWT_ID__
NEWT_SECRET=__NEWT_SECRET__
LOG_LEVEL=__LOG_LEVEL__
# Self-hosted Pangolin: never fall back to Pangolin Cloud.
# (false for Pangolin Cloud, whose exit nodes would all be filtered out)
NO_CLOUD=__NO_CLOUD__
# The SSH auth daemon needs root; disabled because Newt runs unprivileged
DISABLE_SSH=true
# Skip Newt's built-in self-updater cleanly (upstream's switch for its
# official container images); versions are managed by YunoHost instead.
NEWT_SYSTEM_SUBSTRATE=CONTAINER
# Pangolin resources for the published YunoHost domains (empty = none)
BLUEPRINT_FILE=__BLUEPRINT_FILE__
